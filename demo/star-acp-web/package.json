{
  "name": "star-acp-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser UI driving Star over Agent Client Protocol via the official ACP TypeScript SDK and a WebSocket-to-stdio bridge.",
  "scripts": {
    "build": "esbuild src/app.js --bundle --format=esm --platform=browser --outfile=public/app.bundle.js",
    "prestart": "npm run build",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.2.0",
    "express": "^4.19.2",
    "marked": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}
